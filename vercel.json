{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/classrooms/:room/latest", "destination": "/api/classroom?room=:room&action=latest" },
    { "source": "/api/classrooms/:room/:scope/:action", "destination": "/api/classroom?room=:room&scope=:scope&action=:action" },
    { "source": "/demo/air", "destination": "/index.html" },
    { "source": "/demo/co2", "destination": "/index.html" },
    { "source": "/teacher", "destination": "/index.html" },
    { "source": "/teacher/co2", "destination": "/index.html" },
    { "source": "/classroom/:room", "destination": "/index.html" }
  ]
}
